# Virtual environment
venv/

# PyCharm
.idea/
*.iml

# Python cache and test artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Logs and environment files
logs/
*.log.*
*.log
.env

# Private user secrets (API keys, tokens, etc.) — never commit
sensible/

# Large download payloads (keep folder via .gitkeep)
downloads/*
!downloads/.gitkeep

# Local machine config (templates: *.example.json are tracked)
config/download_routes.json
config/programs.json

# Portable / PyInstaller output (publish separately)
build/
dist/
*.spec
