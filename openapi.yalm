openapi: 3.0.3
info:
  title: Remote Task Manager Client API
  version: 26.1019.04
  description: |
    API HTTP del agente cliente (Flask/Waitress).
    La mayoria de rutas protegidas requieren cabecera `X-Client-API-Key`
    (la misma clave que se registra en el servidor Django).

servers:
  - url: http://localhost:5000
    description: Agente local (puerto por defecto)

tags:
  - name: core
  - name: commands
  - name: programs
  - name: downloads
  - name: misc

components:
  securitySchemes:
    ClientApiKey:
      type: apiKey
      in: header
      name: X-Client-API-Key

  schemas:
    ApiSuccess:
      type: object
      properties:
        status:
          type: string
          example: success
        message:
          type: string
        data: {}

    ApiError:
      type: object
      properties:
        status:
          type: string
          example: error
        message:
          type: string
        data: {}

    CommandInfo:
      type: object
      properties:
        command_id:
          type: string
        name:
          type: string
        description:
          type: string
        args:
          type: array
          items:
            type: object
            properties:
              name:
                type: string
              type:
                type: string
              required:
                type: boolean
              description:
                type: string

    ExecuteCommandRequest:
      type: object
      required: [command_id]
      properties:
        command_id:
          type: string
          description: Identificador del comando (tambien se acepta `command` por compatibilidad)
          example: download_file
        command:
          type: string
          description: Alias legacy de command_id
        kwargs:
          type: object
          additionalProperties: true
          description: Argumentos nombrados del comando
          example:
            url: https://example.com/file.bin
        args:
          type: array
          description: Valores posicionales opcionales (se mapean a arg0, arg1, ...)
          items: {}
        message:
          type: string
        title:
          type: string
        time:
          type: integer
        url:
          type: string
        path:
          type: string

    DownloadJob:
      type: object
      properties:
        job_id:
          type: string
        status:
          type: string
          enum: [queued, downloading, completed, error, cancelled]
        url:
          type: string
        filename:
          type: string
        save_dir:
          type: string
        bytes_written:
          type: integer
        bytes_total:
          type: integer
          nullable: true
        progress_pct:
          type: number
          nullable: true
        speed_bps:
          type: number
        message:
          type: string

security:
  - ClientApiKey: []

paths:
  /api/health:
    get:
      tags: [core]
      summary: Health check
      security: []
      responses:
        "200":
          description: Agente en marcha
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApiSuccess"

  /api/test:
    get:
      tags: [misc]
      summary: Smoke test del API
      security: []
      responses:
        "200":
          description: API operativa
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApiSuccess"

  /api/get_time:
    get:
      tags: [misc]
      summary: Hora local del cliente
      security: []
      responses:
        "200":
          description: Marca de tiempo
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApiSuccess"

  /api/command/list:
    get:
      tags: [commands]
      summary: Lista de comandos registrados
      description: |
        Comandos actuales tipicos: `test_command`, `show_popup`, `shutdown`,
        `screenshot`, `list_processes`, `lock_workstation`, `open_url`,
        `execute_program`, `kill_program`, `download_file`.
      responses:
        "200":
          description: Mapa o lista de comandos
          content:
            application/json:
              schema:
                allOf:
                  - $ref: "#/components/schemas/ApiSuccess"
                  - type: object
                    properties:
                      data:
                        type: object
                        additionalProperties:
                          $ref: "#/components/schemas/CommandInfo"
        "401":
          description: API key invalida o ausente
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApiError"

  /api/command/execute:
    post:
      tags: [commands]
      summary: Ejecutar un comando
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ExecuteCommandRequest"
            examples:
              download_file:
                summary: Iniciar descarga
                value:
                  command_id: download_file
                  kwargs:
                    url: https://civitai.com/api/download/models/123
              execute_program:
                summary: Lanzar programa
                value:
                  command_id: execute_program
                  kwargs:
                    path: "C:\\Path\\To\\app.exe"
                    program_key: example_app
              show_popup:
                summary: Popup
                value:
                  command_id: show_popup
                  kwargs:
                    message: Hola
                    title: RTM
              kill_program:
                summary: Detener por PID
                value:
                  command_id: kill_program
                  kwargs:
                    pid: 1234
      responses:
        "200":
          description: Comando ejecutado
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApiSuccess"
        "400":
          description: Falta command_id o argumento requerido
        "401":
          description: API key invalida o ausente
        "404":
          description: Comando no registrado
        "500":
          description: Error al ejecutar

  /api/command:
    post:
      tags: [commands]
      summary: Ejecutar comando (alias legacy)
      description: Misma semantica que `/api/command/execute` (acepta `command` o `command_id`).
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ExecuteCommandRequest"
      responses:
        "200":
          description: Comando ejecutado
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApiSuccess"
        "400":
          description: Peticion invalida
        "401":
          description: API key invalida o ausente
        "404":
          description: Comando no encontrado

  /api/program/list:
    get:
      tags: [programs]
      summary: Lista de programas locales
      description: Lee `config/programs.json` (plantilla en `programs.example.json`).
      responses:
        "200":
          description: Programas indexados por name
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApiSuccess"
        "401":
          description: API key invalida o ausente
        "500":
          description: No se pudo leer programs.json
    post:
      tags: [programs]
      summary: Lista de programas (POST)
      responses:
        "200":
          description: Igual que GET
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApiSuccess"

  /api/program/status:
    get:
      tags: [programs]
      summary: Programas en ejecucion (tracker)
      responses:
        "200":
          description: Mapa por program_key con pid / is_running
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApiSuccess"
        "401":
          description: API key invalida o ausente
    post:
      tags: [programs]
      summary: Estado de programas (POST)
      responses:
        "200":
          description: Igual que GET
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApiSuccess"

  /api/download/list:
    get:
      tags: [downloads]
      summary: Listar trabajos de descarga
      parameters:
        - name: active_only
          in: query
          schema:
            type: boolean
          description: Si true, solo queued/downloading
      responses:
        "200":
          description: Lista de jobs
          content:
            application/json:
              schema:
                allOf:
                  - $ref: "#/components/schemas/ApiSuccess"
                  - type: object
                    properties:
                      data:
                        type: object
                        properties:
                          downloads:
                            type: array
                            items:
                              $ref: "#/components/schemas/DownloadJob"
        "401":
          description: API key invalida o ausente
    post:
      tags: [downloads]
      summary: Listar descargas (POST)
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                active_only:
                  type: boolean
      responses:
        "200":
          description: Lista de jobs
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApiSuccess"

  /api/download/status:
    get:
      tags: [downloads]
      summary: Estado de una descarga
      parameters:
        - name: job_id
          in: query
          required: true
          schema:
            type: string
      responses:
        "200":
          description: Job encontrado
          content:
            application/json:
              schema:
                allOf:
                  - $ref: "#/components/schemas/ApiSuccess"
                  - type: object
                    properties:
                      data:
                        $ref: "#/components/schemas/DownloadJob"
        "400":
          description: Falta job_id
        "401":
          description: API key invalida o ausente
        "404":
          description: Job no encontrado
    post:
      tags: [downloads]
      summary: Estado de una descarga (POST)
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [job_id]
              properties:
                job_id:
                  type: string
      responses:
        "200":
          description: Job encontrado
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApiSuccess"
        "400":
          description: Falta job_id
        "404":
          description: Job no encontrado

  /api/download/cancel:
    post:
      tags: [downloads]
      summary: Cancelar descarga activa
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [job_id]
              properties:
                job_id:
                  type: string
      responses:
        "200":
          description: Cancelacion solicitada
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApiSuccess"
        "400":
          description: No se puede cancelar
        "401":
          description: API key invalida o ausente
        "404":
          description: Job no encontrado

  /api/download/remove:
    post:
      tags: [downloads]
      summary: Quitar job terminado de la lista
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [job_id]
              properties:
                job_id:
                  type: string
      responses:
        "200":
          description: Eliminado de la lista en memoria
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApiSuccess"
        "400":
          description: Job activo u otro error
        "401":
          description: API key invalida o ausente
        "404":
          description: Job no encontrado

  /api/download/clear_finished:
    post:
      tags: [downloads]
      summary: Limpiar jobs completed/error/cancelled
      responses:
        "200":
          description: Numero de jobs eliminados
          content:
            application/json:
              schema:
                allOf:
                  - $ref: "#/components/schemas/ApiSuccess"
                  - type: object
                    properties:
                      data:
                        type: object
                        properties:
                          removed:
                            type: integer
        "401":
          description: API key invalida o ausente
